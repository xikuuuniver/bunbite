{
  "installCommand": "npm install -g pnpm && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/bunbite-restaurant run build",
  "outputDirectory": "artifacts/bunbite-restaurant/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "env": {
    "BASE_PATH": "/"
  }
}
